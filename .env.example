# La app de escritorio NO tiene credenciales de MinIO. Sube los chunks pidiendo
# una presigned URL al concat-service (que sí tiene las claves, en el servidor).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=xxxx
# concat-service que entrega las presigned URLs de subida
UPLOAD_SERVICE_URL=http://192.168.1.175:9210
# AI Transcriptor: use 18766 for its isolated development instance.
# The public URL must be reachable by the employee's browser.
TRANSCRIPTOR_API_URL=http://192.168.1.171:18766
TRANSCRIPTOR_PUBLIC_URL=http://192.168.1.171:18766
# Same value as BRAINRECORD_API_KEY in AI_Transcriptor. Do not commit real keys.
TRANSCRIPTOR_API_KEY=replace-with-shared-development-key
