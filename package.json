{
    "name": "brainlabrecord",
    "version": "1.0.4",
    "description": "Brainlabrecord — grabación de pantalla",
    "author": "Brainlab",
    "main": "dist/main/index.js",
    "scripts": {
        "dev": "node scripts/run.js dev",
        "build": "node scripts/run.js build",
        "dist": "tsc && xcopy /E /I /Y src\\renderer dist\\renderer > nul && electron-builder",
        "publish": "node scripts/publish.js",
        "typecheck": "tsc --noEmit",
        "dev:windows": "tsc && xcopy /E /I /Y src\\renderer dist\\renderer > nul && set ELECTRON_RUN_AS_NODE=&& electron .",
        "build:windows": "tsc && xcopy /E /I /Y src\\renderer dist\\renderer > nul",
        "dev:linux": "node scripts/run.js native",
        "dev:mac": "node scripts/run.js native",
        "test": "npm run build && node --test tests/*.test.cjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.0",
        "electron-updater": "^6.8.9",
        "ffmpeg-static": "^5.2.0",
        "fluent-ffmpeg": "^2.1.3",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@types/fluent-ffmpeg": "^2.1.27",
        "@types/node": "^20.0.0",
        "electron": "^42.11.16",
        "electron-builder": "^26.18.0",
        "minio": "^8.0.7",
        "typescript": "^5.5.0"
    }
}
